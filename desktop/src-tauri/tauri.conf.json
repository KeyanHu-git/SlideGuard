{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SlideGuard",
  "version": "0.2.0",
  "identifier": "io.github.keyanhu.slideguard",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SlideGuard · Tauri 开发预览",
        "width": 1440,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 680,
        "decorations": false,
        "shadow": true,
        "backgroundColor": "#202226"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'none'",
      "capabilities": ["main-window"]
    }
  },
  "bundle": { "active": false }
}
