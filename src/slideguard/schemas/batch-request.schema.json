{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/KeyanHu-git/SlideGuard/schemas/batch-request-1.0.json",
  "title": "SlideGuard BatchRequest 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "jobs"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "batchId": {"type": "string", "minLength": 1, "maxLength": 200},
    "jobs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {"type": "object"}
    },
    "behavior": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "strategy": {"enum": ["continue", "fail-fast"], "default": "continue"},
        "maxAttempts": {"type": "integer", "minimum": 1, "maximum": 3, "default": 1},
        "retryDelayMs": {"type": "integer", "minimum": 0, "maximum": 10000, "default": 0},
        "reuseExisting": {"type": "boolean", "default": true}
      },
      "default": {}
    }
  }
}
