{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/KeyanHu-git/SlideGuard/schemas/batch-result-1.0.json",
  "title": "SlideGuard BatchResult 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "status", "exitCode", "toolVersion", "pipelineRevision", "strategy", "total", "counts", "results", "error"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "batchId": {"type": "string", "minLength": 1},
    "status": {"enum": ["succeeded", "partial", "failed"]},
    "exitCode": {"type": "integer", "minimum": 0},
    "toolVersion": {"type": "string", "minLength": 1},
    "pipelineRevision": {"type": "string", "minLength": 1},
    "strategy": {"enum": ["continue", "fail-fast"]},
    "total": {"type": "integer", "minimum": 0, "maximum": 100},
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["succeeded", "failed", "skipped", "reused"],
      "properties": {
        "succeeded": {"type": "integer", "minimum": 0},
        "failed": {"type": "integer", "minimum": 0},
        "skipped": {"type": "integer", "minimum": 0},
        "reused": {"type": "integer", "minimum": 0}
      }
    },
    "results": {
      "type": "array",
      "maxItems": 100,
      "items": {"$ref": "#/$defs/item"}
    },
    "error": {"$ref": "#/$defs/errorOrNull"}
  },
  "$defs": {
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attempt", "status", "exitCode", "errorCode", "retryable"],
      "properties": {
        "attempt": {"type": "integer", "minimum": 1, "maximum": 3},
        "status": {"enum": ["succeeded", "validated", "failed"]},
        "exitCode": {"type": "integer", "minimum": 0},
        "errorCode": {"type": ["string", "null"]},
        "retryable": {"type": "boolean"}
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["itemIndex", "status", "attempts", "attemptLog", "retryable", "reused", "idempotencyKey", "result", "skipReason"],
      "properties": {
        "itemIndex": {"type": "integer", "minimum": 0, "maximum": 99},
        "taskId": {"type": "string", "minLength": 1},
        "status": {"enum": ["completed", "skipped"]},
        "attempts": {"type": "integer", "minimum": 0, "maximum": 3},
        "attemptLog": {"type": "array", "maxItems": 3, "items": {"$ref": "#/$defs/attempt"}},
        "retryable": {"type": "boolean"},
        "reused": {"type": "boolean"},
        "idempotencyKey": {"type": ["string", "null"], "minLength": 1},
        "result": {"oneOf": [{"$ref": "export-result-1.0.json"}, {"type": "null"}]},
        "skipReason": {"type": ["string", "null"], "minLength": 1}
      },
      "oneOf": [
        {
          "properties": {
            "status": {"const": "completed"},
            "attempts": {"minimum": 0},
            "result": {"type": "object"},
            "skipReason": {"type": "null"}
          }
        },
        {
          "properties": {
            "status": {"const": "skipped"},
            "attempts": {"const": 0},
            "attemptLog": {"maxItems": 0},
            "retryable": {"const": false},
            "reused": {"const": false},
            "idempotencyKey": {"type": "null"},
            "result": {"type": "null"},
            "skipReason": {"type": "string"}
          }
        }
      ]
    },
    "errorOrNull": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["code", "message", "exitCode", "stage", "details"],
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "message": {"type": "string", "minLength": 1},
        "exitCode": {"type": "integer", "minimum": 1},
        "stage": {"type": "string", "minLength": 1},
        "details": {"type": "object"}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "succeeded"}}, "required": ["status"]},
      "then": {"properties": {"exitCode": {"const": 0}, "error": {"type": "null"}}},
      "else": {"properties": {"exitCode": {"minimum": 1}}}
    }
  ]
}
