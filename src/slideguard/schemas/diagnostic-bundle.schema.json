{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/KeyanHu-git/SlideGuard/schemas/diagnostic-bundle-1.0.json",
  "title": "SlideGuard DiagnosticBundle 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "tool", "doctor", "events", "configFingerprint", "report", "recommendations", "safety"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "pipelineRevision"],
      "properties": {
        "version": {"type": "string", "minLength": 1, "maxLength": 40},
        "pipelineRevision": {"type": "string", "minLength": 1, "maxLength": 80}
      }
    },
    "doctor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "platform", "powerpoint", "dependencies", "issues"],
      "properties": {
        "ok": {"type": "boolean"},
        "platform": {
          "type": "object",
          "additionalProperties": false,
          "required": ["system", "release", "machine"],
          "properties": {
            "system": {"type": "string", "minLength": 1, "maxLength": 80},
            "release": {"type": "string", "minLength": 1, "maxLength": 80},
            "machine": {"type": "string", "minLength": 1, "maxLength": 80}
          }
        },
        "powerpoint": {
          "type": "object",
          "additionalProperties": false,
          "required": ["available", "version", "build"],
          "properties": {
            "available": {"type": "boolean"},
            "version": {"type": ["string", "null"], "maxLength": 40},
            "build": {"type": ["string", "null"], "maxLength": 40}
          }
        },
        "dependencies": {
          "type": "object",
          "additionalProperties": false,
          "required": ["powerShell", "pdfToCairo", "pdfToPpm", "pdfInfo", "svgRenderer"],
          "properties": {
            "powerShell": {"type": "boolean"},
            "pdfToCairo": {"type": "boolean"},
            "pdfToPpm": {"type": "boolean"},
            "pdfInfo": {"type": "boolean"},
            "svgRenderer": {"type": "boolean"}
          }
        },
        "issues": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,63}$"}
        }
      }
    },
    "events": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "stage", "exitCode", "transient", "residualRisk"],
        "properties": {
          "code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,63}$"},
          "stage": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"},
          "exitCode": {"type": ["integer", "null"], "minimum": 0, "maximum": 255},
          "transient": {"type": "boolean"},
          "residualRisk": {"type": "boolean"}
        }
      }
    },
    "configFingerprint": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
    "report": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["verdict", "findingCounts", "findingCodes", "artifactKinds"],
      "properties": {
        "verdict": {"enum": ["PASS", "PASS_WITH_SOURCE_WARNINGS", "FAIL", "N/A", "UNKNOWN"]},
        "findingCounts": {
          "type": "object",
          "maxProperties": 8,
          "propertyNames": {"pattern": "^[A-Z][A-Z0-9_]{0,63}$"},
          "additionalProperties": {"type": "integer", "minimum": 0, "maximum": 1000000}
        },
        "findingCodes": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,63}$"}
        },
        "artifactKinds": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,31}$"}
        }
      }
    },
    "recommendations": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "steps"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,63}$"},
          "title": {"type": "string", "minLength": 1, "maxLength": 160},
          "steps": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {"type": "string", "minLength": 1, "maxLength": 300}
          }
        }
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contentPolicy", "privacyPasses", "secretScan", "maxBytes"],
      "properties": {
        "contentPolicy": {"const": "metadata-only"},
        "privacyPasses": {"const": 2},
        "secretScan": {"const": "passed"},
        "maxBytes": {"type": "integer", "minimum": 1024, "maximum": 262144}
      }
    }
  }
}
