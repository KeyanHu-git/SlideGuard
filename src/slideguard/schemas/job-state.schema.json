{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://slideguard.local/schemas/job-state.schema.json",
  "title": "SlideGuard recoverable job checkpoint",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "taskId",
    "workspaceNonce",
    "requestFingerprint",
    "resumeKey",
    "source",
    "tool",
    "selectedSlides",
    "state",
    "artifacts",
    "complete",
    "writtenAt"
  ],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "kind": {"const": "slideguard-checkpoint"},
    "taskId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001f/\\\\:]+$"
    },
    "workspaceNonce": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "requestFingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "resumeKey": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "sha256"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[^\\u0000-\\u001f/\\\\:]+$"
        },
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "pipelineRevision", "checkpointContractVersion"],
      "properties": {
        "version": {"type": "string", "minLength": 1, "maxLength": 64},
        "pipelineRevision": {"type": "string", "minLength": 1, "maxLength": 128},
        "checkpointContractVersion": {"const": "1.0"}
      }
    },
    "selectedSlides": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 1}
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "phase", "status", "cursor"],
      "properties": {
        "sequence": {"type": "integer", "minimum": 0},
        "phase": {
          "enum": [
            "DISCOVER",
            "PREFLIGHT",
            "INVENTORY",
            "NATIVE_EXPORT",
            "PATCH",
            "VALIDATE",
            "PACKAGE",
            "PUBLISH"
          ]
        },
        "status": {"enum": ["pending", "complete"]},
        "cursor": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["outputOrdinal", "sourceSlide"],
              "properties": {
                "outputOrdinal": {"type": "integer", "minimum": 1},
                "sourceSlide": {"type": "integer", "minimum": 1}
              }
            }
          ]
        }
      }
    },
    "artifacts": {
      "type": "array",
      "maxItems": 100000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "path", "bytes", "sha256", "phase", "sequence"],
        "properties": {
          "kind": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
          },
          "bytes": {"type": "integer", "minimum": 0},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "phase": {
            "enum": [
              "DISCOVER",
              "PREFLIGHT",
              "INVENTORY",
              "NATIVE_EXPORT",
              "PATCH",
              "VALIDATE",
              "PACKAGE",
              "PUBLISH"
            ]
          },
          "sequence": {"type": "integer", "minimum": 0}
        }
      }
    },
    "complete": {"type": "boolean"},
    "writtenAt": {"type": "string", "format": "date-time"}
  }
}
