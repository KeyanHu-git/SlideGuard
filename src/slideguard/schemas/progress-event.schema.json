{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/KeyanHu-git/SlideGuard/schemas/progress-event-1.0.json",
  "title": "SlideGuard ProgressEvent 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "event", "sequence", "timestamp", "phase", "state", "completed", "total", "message"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "event": {"const": "progress"},
    "taskId": {"type": "string", "minLength": 1},
    "sequence": {"type": "integer", "minimum": 0},
    "timestamp": {"type": "string", "format": "date-time"},
    "phase": {"type": "string", "minLength": 1},
    "state": {"enum": ["start", "update", "complete"]},
    "completed": {"type": "integer", "minimum": 0},
    "total": {"type": "integer", "minimum": 0},
    "slide": {"type": "integer", "minimum": 1},
    "message": {"type": "string"}
  }
}
